  "product": {
    "name": "Relay",
    "domain": "watching deployments go out and catching the ones that go wrong",
    "audience": "an on-call platform engineer, usually with the dashboard on a second monitor while doing something else",
    "nouns": [
      "deployment",
      "pipeline",
      "rollback",
      "commit",
      "environment",
      "incident",
      "build"
    ],
    "screens": [
      "deployment list",
      "deployment detail",
      "pipeline run",
      "incident timeline"
    ]
  },
  "brand": {
    "accentHue": 195,
    "neutralHue": 250,
    "source": "derived",
    "rationale": "A cyan-leaning blue at OKLCH hue 195, chosen because the status roles already own green, amber and red on this product — a deployment dashboard is mostly status, so the accent has to stay clear of all three signal hues to avoid reading as a fourth status. The neutral is cool (hue 250) rather than warm: this surface is watched on a dark second monitor for hours, and a cool ramp sits back further behind the status colours."
  },
