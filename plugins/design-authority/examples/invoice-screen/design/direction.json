  "product": {
    "name": "Handwerk Leads",
    "domain": "buying qualified job leads, and the invoices for them",
    "audience": "a self-employed German tradesman — Elektriker, Dachdecker, Sanitär — who buys leads between jobs, usually on a phone in a van or a laptop at the kitchen table after hours",
    "nouns": [
      "invoice",
      "lead",
      "Rechnung",
      "Leistungszeitraum",
      "tradesman",
      "job",
      "payout",
      "VAT",
      "Umsatzsteuer"
    ],
    "screens": [
      "lead inbox",
      "invoice list",
      "invoice detail",
      "payment confirmation"
    ]
  },
  "brand": {
    "accentHue": 245,
    "neutralHue": 85,
    "source": "derived",
    "rationale": "A true blue at OKLCH hue 245, deliberately short of the 260-280 band where every fintech brand already sits. It is used for links, focus and selection only — the primary action is ink, so the accent never has to carry a button fill and can stay dark enough to pass as text. The neutral is warm (hue 85, chroma under 0.013) because this is money software a tradesman reads at the end of a long day, and a cool blue-grey reads as cold tech."
  },
